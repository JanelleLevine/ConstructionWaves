{
  "name": "san-francisco-wave-fractals",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "data:fetch": "tsx scripts/fetchNdbc.ts",
    "data:process": "tsx scripts/aggregateDaily.ts",
    "data": "npm run data:fetch && npm run data:process",
    "data:cdip:fetch": "tsx scripts/fetchCdip.ts",
    "data:cdip:process": "tsx scripts/aggregateCdip.ts",
    "data:cdip": "npm run data:cdip:fetch && npm run data:cdip:process",
    "assets:months": "tsx scripts/generateMonthImages.ts"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "luxon": "^3.6.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "sharp": "^0.35.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  }
}
